# Utilise l'image de base Node.js
FROM node:20-alpine

# Crée le répertoire de travail
WORKDIR /app

# Installe les dépendances nécessaires pour Prisma et PostgreSQL
RUN apk add --no-cache libc6-compat openssl

# Copie TOUS les fichiers de l'application dans l'image
# C'est le changement crucial qui garantit que /prisma/migrations est à jour.
COPY . .

# Installe les dépendances npm
RUN npm ci --legacy-peer-deps

# La commande par défaut qui sera exécutée (peut être surchargée par docker-compose)
CMD ["npm", "run", "db:migrate"]