# Utilise l'image de base Node.js
FROM node:20-alpine

# Crée le répertoire de travail
WORKDIR /app

# Installe les dépendances nécessaires pour Prisma et PostgreSQL
RUN apk add --no-cache libc6-compat openssl

# Copie les fichiers de dépendances et le schéma Prisma
COPY package.json package-lock.json* ./
COPY prisma ./prisma/

# Installe les dépendances (le postinstall "prisma generate" va maintenant fonctionner)
RUN npm ci --legacy-peer-deps

# Copie le reste des fichiers (pas strictement nécessaire pour la migration, mais bonne pratique)
COPY . .

# La commande par défaut qui sera exécutée
CMD ["npm", "run", "db:migrate"]
