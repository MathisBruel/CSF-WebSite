generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBRE_ACTIF
  ADHERENT_CLUB
}

enum ExhibitionStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  VALIDATED
  REJECTED
  WAITING_DOCS
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DocumentType {
  PEDIGREE
  ICAD
  VACCIN
  OTHER
}

enum ExposantType {
  PARTICULIER
  ELEVEUR
  SOCIETE
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  password      String?
  name          String
  firstName     String
  lastName      String
  civilite      String?
  phone         String?
  phoneFixed    String?
  address       String?
  address2      String?
  city          String?
  postalCode    String?
  country       String   @default("France")
  exposantType      ExposantType @default(PARTICULIER)
  certificatCapacite String?
  role          Role     @default(ADHERENT_CLUB)
  membershipActive Boolean @default(false)
  membershipExpiry DateTime?
  newsletterSubscribed Boolean @default(true)
  avatarUrl     String?
  bio           String?
  siret         String?
  affixe        String?
  breedingName  String?
  website       String?
  gpsCoordinates String?
  otherClubs    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cats               Cat[]
  registrations      Registration[]
  news               News[]
  documents          Document[]
  teamMembers        TeamMember[]
  membershipRequests MembershipRequest[]

  @@map("users")
}

// ─── Cat ─────────────────────────────────────────────────────────────────────

model Cat {
  id            String   @id @default(cuid())
  name          String
  breed         String
  color         String?
  gender        String
  birthDate     DateTime
  icadNumber    String?  @unique
  pedigreeNumber         String?
  pedigreeInProgress     Boolean  @default(false)
  foreignCatCertificate  String?
  inscritChampionnatFrance Boolean @default(false)
  isHouseCat    Boolean  @default(false)
  photoUrl      String?
  eyeColor        String?
  breeder         String?
  father          String?
  mother          String?
  countryOfOrigin String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vaccinations  Vaccination[]
  catDocuments  CatDocument[]
  registrations RegistrationCat[]

  @@map("cats")
}

model Vaccination {
  id          String   @id @default(cuid())
  catId       String
  cat         Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  vaccineName String
  date        DateTime
  expiryDate  DateTime
  vetName     String?
  documentUrl String?
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("vaccinations")
}

model CatDocument {
  id          String       @id @default(cuid())
  catId       String
  cat         Cat          @relation(fields: [catId], references: [id], onDelete: Cascade)
  type        DocumentType
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  validated   Boolean      @default(false)
  rejectionReason String?
  uploadedAt  DateTime     @default(now())
  validatedAt DateTime?

  @@map("cat_documents")
}

// ─── Exhibition ───────────────────────────────────────────────────────────────

model Exhibition {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String?
  location        String
  address         String?
  city            String
  startDate       DateTime
  endDate         DateTime
  registrationDeadline DateTime
  status          ExhibitionStatus @default(DRAFT)
  maxRegistrations Int?
  coverImageUrl   String?

  rules           String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  registrations   Registration[]
  specials        ExhibitionSpecial[]

  @@map("exhibitions")
}

model ExhibitionSpecial {
  id           String     @id @default(cuid())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  name         String
  createdAt    DateTime   @default(now())

  @@map("exhibition_specials")
}

// ─── Registration ─────────────────────────────────────────────────────────────

model Registration {
  id             String             @id @default(cuid())
  exhibitionId   String
  exhibition     Exhibition         @relation(fields: [exhibitionId], references: [id])
  userId         String
  user           User               @relation(fields: [userId], references: [id])

  status         RegistrationStatus @default(PENDING)
  paymentStatus  PaymentStatus      @default(PENDING)
  registrationFee Int               @default(5)
  totalAmount    Float
  paidAt         DateTime?

  personalCages            Int      @default(0)
  borrowedCages            Int      @default(0)
  cageSpecialLengthRequest String?

  nextTo         String?
  comment        String?

  adminNotes     String?
  rejectionReason String?
  convocationUrl String?
  convocationSentAt DateTime?

  cats           RegistrationCat[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([exhibitionId, userId])
  @@map("registrations")
}

model RegistrationCat {
  id               String       @id @default(cuid())
  registrationId   String
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  catId            String
  cat              Cat          @relation(fields: [catId], references: [id])

  participationDays    String[]
  traditionalClass     String?
  traditionalClassOther String?
  isHorsConcours       Boolean  @default(false)
  isHouseCat           Boolean  @default(false)
  wantsComplianceExam  Boolean  @default(false)
  wantsDiploma         Boolean  @default(false)
  specialParticipations String[]

  amount           Float

  catalogNumber    Int?
  vetValidated     Boolean  @default(false)
  vetValidatedAt   DateTime?
  vetNotes         String?

  @@unique([registrationId, catId])
  @@map("registration_cats")
}

// ─── News ────────────────────────────────────────────────────────────────────

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImageUrl String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

// ─── Document (public downloadable docs) ─────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  category    String   @default("general")
  public      Boolean  @default(true)
  uploadedById String
  uploadedBy  User     @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

// ─── Team ─────────────────────────────────────────────────────────────────────

model TeamMember {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  role      String
  bio       String?
  photoUrl  String?
  email     String?
  phone     String?
  instagram String?
  facebook  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// ─── MembershipRequest ────────────────────────────────────────────────────────

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model MembershipRequest {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          MembershipRequestStatus @default(PENDING)
  message         String?
  rejectionReason String?
  requestedAt     DateTime                @default(now())
  resolvedAt      DateTime?

  @@map("membership_requests")
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── SiteConfig ───────────────────────────────────────────────────────────────

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_config")
}

// ─── Email Verification ───────────────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verification_tokens")
}

// ─── Pricing ──────────────────────────────────────────────────────────────────

model Pricing {
  id                      String   @id @default(cuid())
  registrationFee         Int      @default(5)
  memberOneDayCat12       Int      @default(36)
  memberOneDayCat3Plus    Int      @default(31)
  memberOneDayHouseCat    Int      @default(30)
  memberTwoDayCat12       Int      @default(46)
  memberTwoDayCat3Plus    Int      @default(41)
  memberTwoDayHouseCat    Int      @default(35)
  memberConformite        Int      @default(10)
  memberDiploma           Int      @default(0)
  nonMemberOneDayCat12    Int      @default(42)
  nonMemberOneDayCat3Plus Int      @default(36)
  nonMemberOneDayHouseCat Int      @default(30)
  nonMemberTwoDayCat12    Int      @default(51)
  nonMemberTwoDayCat3Plus Int      @default(46)
  nonMemberTwoDayHouseCat Int      @default(35)
  nonMemberConformite     Int      @default(15)
  nonMemberDiploma        Int      @default(10)
  membershipFee           Int      @default(25)
  cageDeposit             Int      @default(100)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("pricing")
}
