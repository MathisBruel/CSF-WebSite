# Database
DATABASE_URL="postgresql://csf_user:csf_password@localhost:5432/csf_db"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# File uploads (local storage path inside container)
UPLOAD_DIR="/app/uploads"
NEXT_PUBLIC_UPLOAD_URL="/uploads"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Chats Sans Frontières"

# TinyMCE (get free key at https://www.tiny.cloud/develop/free-tier/)
NEXT_PUBLIC_TINYMCE_API_KEY="your-tinymce-api-key"

# SMTP (email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@assocsf.fr"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Chats Sans Frontières <no-reply@assocsf.fr>"
ADMIN_EMAIL="contact@assocsf.fr"
INSCRIPTION_EMAIL="inscription@assocsf.fr"
