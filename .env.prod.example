# ── Images GHCR ───────────────────────────────────────────────────────────────
# Remplace 'your-github-username' par ton nom d'utilisateur GitHub (lowercase)
APP_IMAGE=ghcr.io/your-github-username/csf-web
MIGRATE_IMAGE=ghcr.io/your-github-username/csf-migrate

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=csf_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=csf_db

# ── Port hôte (doit correspondre à la config Apache ProxyPass) ────────────────
APP_PORT=3001

# ── Application ────────────────────────────────────────────────────────────────
# Doit correspondre à POSTGRES_USER / PASSWORD / DB ci-dessus
DATABASE_URL=postgresql://csf_user:change-me-strong-password@postgres:5432/csf_db

# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=change-me

NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_TINYMCE_API_KEY=your-tinymce-key
UPLOAD_DIR=/app/public/uploads
NEXT_PUBLIC_UPLOAD_URL=/uploads
